# FraudShield Public Client Environment Variables
# Duplicate this file to .env and configure with your real values.

# The public URL of your Supabase project (e.g. https://xxxx.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# The public anonymous API key (anon key) for client-side API requests
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
